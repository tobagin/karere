+//! Debug-only readback of explicitly selected, generated fixture frames.
+use gtk::{gdk, prelude::*};
+use std::{
+    cell::RefCell,
+    sync::OnceLock,
+    time::{Duration, Instant},
+};
+
+#[derive(Default)]
+struct State {
+    started: Option<Instant>,
+    size: (i32, i32),
+    resize: u64,
+    per_size: u8,
+    checked: u64,
+    bad: u64,
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        std::env::var("KARERE_GENERATED_FRAME_INTEGRITY").as_deref() == Ok("1")
+            && std::env::var("GSETTINGS_BACKEND").as_deref() == Ok("memory")
+            && crate::parse_url_flag().is_some_and(|url| {
+                url.starts_with("data:text/html")
+                    && url.contains("CEF%20frame%20integrity%20fixture")
+            })
+    })
+}
+
+fn ready(width: i32, height: i32) -> bool {
+    if !enabled() || width < 32 || height < 32 {
+        return false;
+    }
+    STATE.with_borrow_mut(|state| {
+        let started = *state.started.get_or_insert_with(Instant::now);
+        if started.elapsed() < Duration::from_secs(5) {
+            return false;
+        }
+        if state.size != (width, height) {
+            state.size = (width, height);
+            state.resize += 1;
+            state.per_size = 0;
+        }
+        if state.per_size >= 3 {
+            return false;
+        }
+        state.per_size += 1;
+        true
+    })
+}
+
+fn inspect(pixels: &[u8], stride: usize, rect: (i32, i32, i32, i32), transfer: &str) {
+    let (left, top, width, height) = rect;
+    let offset = |x: i32, y: i32| (top + y) as usize * stride + (left + x) as usize * 4;
+    let index = offset(width / 32, height / 32);
+    let Some(first) = pixels.get(index..index + 4) else {
+        return;
+    };
+    let frame = i32::from(first[2]) - 64;
+    let palette = (0..128).contains(&frame)
+        && (i32::from(first[1]) - (64 + frame * 37 % 128)).abs() <= 2
+        && (i32::from(first[0]) - (64 + frame * 53 % 128)).abs() <= 2;
+    let mut unequal = 0;
+    for y in 0..16 {
+        for x in 0..16 {
+            let index = offset((2 * x + 1) * width / 32, (2 * y + 1) * height / 32);
+            let Some(pixel) = pixels.get(index..index + 4) else {
+                unequal += 1;
+                continue;
+            };
+            if pixel[..3]
+                .iter()
+                .zip(&first[..3])
+                .any(|(a, b)| a.abs_diff(*b) > 2)
+                || pixel[3] < 253
+            {
+                unequal += 1;
+            }
+        }
+    }
+    STATE.with_borrow_mut(|state| {
+        state.checked += 1;
+        if unequal > 0 || !palette {
+            state.bad += 1;
+        }
+        eprintln!(
+            "KARERE_INTEGRITY {}",
+            serde_json::json!({
+                "resize":state.resize, "width":width, "height":height,
+                "checked":state.checked, "bad":state.bad, "transfer":transfer,
+                "unequal":unequal, "palette_valid":palette,
+                "first_bgra":first, "generated_only":true, "performance_sample":false
+            })
+        );
+    });
+}
+
+pub fn texture(texture: &gdk::Texture, crop: Option<(i32, i32, i32, i32)>) {
+    let rect = crop.unwrap_or((0, 0, texture.width(), texture.height()));
+    if !ready(rect.2, rect.3) {
+        return;
+    }
+    let _deadline = crate::gpu_recovery::Deadline::arm();
+    let mut download = gdk::TextureDownloader::new(texture);
+    download.set_format(gdk::MemoryFormat::B8g8r8a8Premultiplied);
+    let (bytes, stride) = download.download_bytes();
+    inspect(&bytes, stride, rect, "accelerated");
+}
+
+pub fn cpu(pixels: &[u8], width: i32, height: i32) {
+    if ready(width, height) {
+        inspect(pixels, width as usize * 4, (0, 0, width, height), "cpu");
+    }
+}
