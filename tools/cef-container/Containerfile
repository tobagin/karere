# CEF proprietary-codec builder. Builds x64 + arm64 minimal distributions with
# checksums/provenance in /out. Mount /work persistently to retain build caches.
#
#   podman build -f tools/cef-container/Containerfile -t cef-codecs tools/
#   podman run --rm -e CEF_BUILD_MODE=legacy-current-pin \
#     -v ./cef-work:/work:Z -v ./cef-out:/out:Z cef-codecs
#
#   Upgrade: CEF_BUILD_MODE=upgrade, CEF_VERSION + CEF_BRANCH + CEF_CHECKOUT;
#            blocked until tools/cef-release-policy.json has a verified minimum.
#   env overrides:
#                 ARCHES="x64" (default "x64 arm64"),
#                 CEF_NINJA_JOBS=6 (cap parallelism on a memory-tight host)
#
# Package set mirrors the proven .github/workflows/build-cef-codecs.yml runner:
# with use_sysroot=true everything else comes from Chromium's bundled toolchain.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 curl ca-certificates lsb-release file unzip bzip2 xz-utils \
      build-essential pkg-config patch \
      libx11-6 libxext6 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY build-cef-codecs.sh /opt/karere/build-cef-codecs.sh
COPY cef-release.py cef-release-policy.json /opt/karere/
COPY cef-patches/ /opt/karere/cef-patches/
COPY cef-container/entrypoint.sh /opt/karere/entrypoint.sh
RUN chmod +x /opt/karere/build-cef-codecs.sh /opt/karere/entrypoint.sh

VOLUME /work
ENTRYPOINT ["/opt/karere/entrypoint.sh"]
