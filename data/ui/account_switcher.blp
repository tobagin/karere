using Gtk 4.0;
using Adw 1;

// Desktop account-switcher popover (mobile variant = BottomSheet in window.blp);
// both share a row list rebuilt in Rust on `accounts-changed`. Parented to `account_button`.
Popover account_switcher_popover {
  has-arrow: true;
  position: bottom;

  child: Gtk.Box {
    orientation: vertical;
    margin-top: 8;
    margin-bottom: 8;
    margin-start: 8;
    margin-end: 8;
    spacing: 6;
    width-request: 300;

    Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;
      propagate-natural-height: true;
      max-content-height: 400;

      Gtk.ListBox accounts_list_popover {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }

    Gtk.Separator {
      margin-top: 4;
      margin-bottom: 4;
    }

    Gtk.Button {
      child: Adw.ButtonContent {
        icon-name: "list-add-symbolic";
        label: _("Add new account");
      };

      action-name: "win.add-account";
    }
  };
}
