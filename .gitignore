# (skills, commands) so /opsx OpenSpec commands work in-repo.
.claude/settings.local.json
*.gresource
/data/ui/*.ui
/build-pot
/po/*.pot~
/po/*.po~
.idea/
.vscode/
*.swp
cef-out/
