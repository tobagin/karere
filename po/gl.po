#: data/io.github.tobagin.karere.metainfo.xml.in:681
msgid "Improved system integration with latest platform libraries"
msgstr ""
"Mellorada a integración co sistema coas últimas bibliotecas da plataforma"

#: data/io.github.tobagin.karere.metainfo.xml.in:788
msgid "Improved translation file consistency"
