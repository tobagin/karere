#: data/io.github.tobagin.karere.metainfo.xml.in:690
msgid "📸 Screenshots and Documentation Update"
msgstr "📸 Aktualizácia snímok obrazovky a dokumentácie"

#: data/io.github.tobagin.karere.metainfo.xml.in:651
msgid "🔄 Manual reload and auto-reload on network reconnection"
