"🔄 Manuálne znovu načítanie a automatické znovu načítanie pri opätovnom "
"pripojení k sieti"

#: data/io.github.tobagin.karere.metainfo.xml.in:710
msgid "🔤 Integrated 80+ language dictionaries from LibreOffice"
msgstr "🔤 Integrovaných 80+ jazykových slovníkov z LibreOffice"

#: data/io.github.tobagin.karere.metainfo.xml.in:817
msgid "🔧 Code Refactoring and Architecture Improvements"
msgstr "🔧 Refaktorizácia kódu a vylepšenia architektúry"

#: data/io.github.tobagin.karere.metainfo.xml.in:668
msgid "🔧 Maintenance Release"
