msgstr "Popravljene tekme ob zagonu in težave z rabo virov"

#: data/io.github.tobagin.karere.metainfo.xml.in:242
msgid ""
"Added Zoom support (Ctrl +/-/0) with persistence and preference controls"
msgstr ""
"Dodana podpora za povečavo (Ctrl +/-/0) s trajnostjo in nadzorom v "
