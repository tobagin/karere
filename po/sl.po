msgstr ""
"Dodana obravnava dovoljenj WebRTC v pripravi na glasovne/video klice "
"WhatsApp Web"

#: data/io.github.tobagin.karere.metainfo.xml.in:258
msgid "Improved mobile UI resizing consistency"
msgstr "Izboljšana doslednost spreminjanja velikosti mobilnega vmesnika"

#: data/io.github.tobagin.karere.metainfo.xml.in:265
msgid ""
"Fixed: App now respects system \"Do Not Disturb\" settings on GNOME "
"(silences sounds)"
msgstr ""
"Popravljeno: program zdaj upošteva sistemske nastavitve \"Ne moti\" na GNOME"
