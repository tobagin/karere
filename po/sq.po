#: data/io.github.tobagin.karere.metainfo.xml.in:470
msgid "Fixed missing GSettings schema in Flatpak builds"
msgstr "Rregulluar skema GSettings që mungonte në ndërtimet Flatpak"

#: data/io.github.tobagin.karere.metainfo.xml.in:585
