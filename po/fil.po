#: data/io.github.tobagin.karere.metainfo.xml.in:345
msgid "Fixed: Panic in notification handling"
msgstr "Naayos: Panic sa paghawak ng abiso"

#: data/io.github.tobagin.karere.metainfo.xml.in:369
msgid ""
"Fixed: Resolved webview reload loop on startup due to incorrect window size "
