msgstr "📚 Imerekebisha URL za hazina ya GitHub (karere-vala → karere)"

#: data/io.github.tobagin.karere.metainfo.xml.in:709
msgid "📝 Added comprehensive spell checking system with auto-detection"
msgstr ""
"📝 Imeongeza mfumo kamili wa ukaguzi wa tahajia wenye ugunduzi otomatiki"

#: data/io.github.tobagin.karere.metainfo.xml.in:656
msgid "📝 Async dictionary loading for smoother Spell Check initialization"
msgstr ""
"📝 Upakiaji wa kamusi usio sambamba kwa uanzishaji laini wa Ukaguzi wa "
"Tahajia"

#: data/io.github.tobagin.karere.metainfo.xml.in:679
msgid "📝 Documentation and Metadata Update"
msgstr "📝 Sasisho la Nyaraka na Metadata"

#: data/io.github.tobagin.karere.metainfo.xml.in:707
msgid ""
"📥 Implemented download manager with custom directory and toast notifications"
msgstr ""
"📥 Imetekeleza kidhibiti cha vipakuliwa chenye saraka maalum na arifa za "
"toast"

#: data/io.github.tobagin.karere.metainfo.xml.in:732
msgid "📸 Reorganized screenshots into data/screenshots/ directory"
msgstr "📸 Imepanga upya picha za skrini katika saraka ya data/screenshots/"

#: data/io.github.tobagin.karere.metainfo.xml.in:690
msgid "📸 Screenshots and Documentation Update"
msgstr "📸 Sasisho la Picha za Skrini na Nyaraka"

#: data/io.github.tobagin.karere.metainfo.xml.in:651
msgid "🔄 Manual reload and auto-reload on network reconnection"
msgstr ""
"🔄 Upakiaji upya wa mkono na otomatiki wakati wa kuunganishwa upya kwa "
"mtandao"

#: data/io.github.tobagin.karere.metainfo.xml.in:710
msgid "🔤 Integrated 80+ language dictionaries from LibreOffice"
msgstr "🔤 Imeunganisha kamusi za lugha 80+ kutoka LibreOffice"

#: data/io.github.tobagin.karere.metainfo.xml.in:817
msgid "🔧 Code Refactoring and Architecture Improvements"
msgstr "🔧 Urekebishaji wa Msimbo na Maboresho ya Usanifu"

#: data/io.github.tobagin.karere.metainfo.xml.in:668
msgid "🔧 Maintenance Release"
msgstr "🔧 Toleo la Matengenezo"

#: data/io.github.tobagin.karere.metainfo.xml.in:853
msgid "🔧 Metadata and Standards Compliance"
msgstr "🔧 Uzingatifu wa Metadata na Viwango"

#: data/io.github.tobagin.karere.metainfo.xml.in:706
msgid "🖼️ Added image paste support via clipboard (Ctrl+V)"
msgstr ""
"🖼️ Imeongeza usaidizi wa kubandika picha kupitia ubao wa kunakili (Ctrl+V)"

#: data/io.github.tobagin.karere.metainfo.xml.in:728
msgid "🗑️ Cleaned up obsolete test files and unused dependencies"
msgstr ""
"🗑️ Imesafisha faili za majaribio zilizopitwa na wakati na vitegemezi "
"visivyotumika"

#: data/io.github.tobagin.karere.metainfo.xml.in:727
msgid ""
"🗑️ Removed Do Not Disturb feature (handled by system notification daemon)"
msgstr ""
"🗑️ Imeondoa kipengele cha Usisumbue (kinashughulikiwa na daemon ya arifa ya "
"mfumo)"

#: data/io.github.tobagin.karere.metainfo.xml.in:729
msgid "🗑️ Removed json-glib, gee, and libsoup dependencies"
msgstr "🗑️ Imeondoa vitegemezi vya json-glib, gee, na libsoup"

#: data/io.github.tobagin.karere.metainfo.xml.in:887
msgid "🚀 Major Architecture Migration: Python to Vala/GTK4"
msgstr "🚀 Uhamiaji Mkubwa wa Usanifu: Python hadi Vala/GTK4"

#: data/io.github.tobagin.karere.metainfo.xml.in:650
msgid "🚀 Start in background option for autostart"
msgstr "🚀 Chaguo la kuanza kwenye mandharinyuma kwa kuanza otomatiki"

#: data/io.github.tobagin.karere.metainfo.xml.in:730
msgid "🧹 Centralized settings management with SettingsManager singleton"
msgstr ""
"🧹 Imeweka kati usimamizi wa mipangilio ukiwa na singleton ya SettingsManager"

#: data/io.github.tobagin.karere.metainfo.xml.in:731
msgid "🧹 Removed DependencyContainer.vala (unused dependency injection)"
msgstr ""
"🧹 Imeondoa DependencyContainer.vala (udungaji wa vitegemezi usiotumika)"

