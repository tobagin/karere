msgstr "Imeboresha uthabiti wa emoji ukiwa na mfumo wa fonti uliojumuishwa"

#: data/io.github.tobagin.karere.metainfo.xml.in:582
msgid "Optimized font loading to eliminate display conflicts"
msgstr "Imeboresha upakiaji wa fonti ili kuondoa migongano ya uonyeshaji"

