"Melhorada a renderização de ícones (os ícones simbólicos usam agora "
"currentColor)"

#: data/io.github.tobagin.karere.metainfo.xml.in:826
msgid "Improved memory efficiency and startup performance"
msgstr "Eficiência de memória e desempenho de arranque melhorados"

#: data/io.github.tobagin.karere.metainfo.xml.in:377
msgid "Improved mobile UI resizing consistency"
msgstr "Melhorada a consistência do redimensionamento da interface móvel"

#: data/io.github.tobagin.karere.metainfo.xml.in:428
msgid "Improved overall stability"
msgstr "Melhorada a estabilidade geral"

#: data/io.github.tobagin.karere.metainfo.xml.in:681
msgid "Improved system integration with latest platform libraries"
