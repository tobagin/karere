#: data/io.github.tobagin.karere.metainfo.xml.in:637
#: data/io.github.tobagin.karere.metainfo.xml.in:685
#: data/io.github.tobagin.karere.metainfo.xml.in:705
#: data/io.github.tobagin.karere.metainfo.xml.in:761
#: data/io.github.tobagin.karere.metainfo.xml.in:778
