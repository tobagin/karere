msgstr "📚 ಕಾಗುಣಿತ ಪರಿಶೀಲನೆ ಕಾನ್ಫಿಗರೇಶನ್ ಮಾರ್ಗದರ್ಶಿಯನ್ನು ಸೇರಿಸಲಾಗಿದೆ"

#: data/io.github.tobagin.karere.metainfo.xml.in:669
msgid "📚 Documented all keyboard shortcuts by category"
msgstr "📚 ವರ್ಗದ ಪ್ರಕಾರ ಎಲ್ಲಾ ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ದಸ್ತಾವೇಜು ಮಾಡಲಾಗಿದೆ"

#: data/io.github.tobagin.karere.metainfo.xml.in:668
msgid "📚 Enhanced README with accessibility features documentation"
msgstr "📚 ಪ್ರವೇಶಸಾಧ್ಯತೆ ವೈಶಿಷ್ಟ್ಯಗಳ ದಸ್ತಾವೇಜನ್ನುಂದಿಗೆ README ವರ್ಧಿಸಲಾಗಿದೆ"

#: data/io.github.tobagin.karere.metainfo.xml.in:671
msgid "📚 Fixed GitHub repository URLs (karere-vala → karere)"
msgstr "📚 GitHub ರೆಪೊಸಿಟರಿ URL ಗಳನ್ನು ಸರಿಪಡಿಸಲಾಗಿದೆ (karere-vala → karere)"

#: data/io.github.tobagin.karere.metainfo.xml.in:633
msgid "📝 Added comprehensive spell checking system with auto-detection"
msgstr "📝 ಸ್ವಯಂ-ಪತ್ತೆಯೊಂದಿಗೆ ಸಮಗ್ರ ಕಾಗುಣಿತ ಪರಿಶೀಲನೆ ವ್ಯವಸ್ಥೆ ಸೇರಿಸಲಾಗಿದೆ"

#: data/io.github.tobagin.karere.metainfo.xml.in:580
msgid "📝 Async dictionary loading for smoother Spell Check initialization"
