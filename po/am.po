#: data/io.github.tobagin.karere.metainfo.xml.in:53
msgid "About dialog showing application information"
msgstr "የመተግበሪያ መረጃ የሚያሳይ የስለ መገናኛ"

#: data/ui/preferences.ui:348
msgid "Accessibility"
msgstr "ተደራሽነት"

#: data/ui/preferences.ui:428
msgid "Accessibility Shortcuts"
msgstr "የተደራሽነት አቋራጮች"

#: data/ui/preferences.ui:378
msgid "Accessibility Zoom"
msgstr "የተደራሽነት ማጉላት"

#: data/io.github.tobagin.karere.metainfo.xml.in:234
msgid ""
"Accessibility preferences: reduce-motion, focus-ring visibility, and caret "
"browsing"
msgstr "የተደራሽነት ምርጫዎች፦ እንቅስቃሴ-ቅነሳ፣ የትኩረት-ቀለበት ታይነት፣ እና የጠቋሚ ማሰስ"

#: data/io.github.tobagin.karere.metainfo.xml.in:230
msgid ""
"Account identity (name + avatar) auto-discovered from WhatsApp Web's "
"internal Store, with a degraded DOM-scrape fallback surfaced by a badge"
msgstr ""
"የመለያ ማንነት (ስም + አምሳያ) ከ WhatsApp Web ውስጣዊ Store በራስ ሰር ይገኛል፣ በባጅ የሚታይ ዝቅ ያለ "
"የ DOM-ቅሰማ መጠባበቂያ ጋር"

#: data/ui/keyboard-shortcuts.ui:38
msgid "Accounts"
msgstr "መለያዎች"

#: data/ui/window.ui:237 data/ui/account_switcher.ui:48
msgid "Add new account"
msgstr "አዲስ መለያ ጨምር"

#: data/io.github.tobagin.karere.metainfo.xml.in:497
msgid "Add new contributor Sabri Ünal to the About dialog"
msgstr "አዲስ አስተዋጽዖ አበርካች Sabri Ünal ን ወደ ስለ መገናኛ ጨምር"

#: data/io.github.tobagin.karere.metainfo.xml.in:519
msgid "Add xdg-config/autostart permission for autostart support"
msgstr "ለራስ ማስጀመር ድጋፍ የ xdg-config/autostart ፈቃድ ጨምር"

#: data/io.github.tobagin.karere.metainfo.xml.in:537
msgid "Added \"Run on Startup\" toggle in preferences (default: false)"
msgstr "በምርጫዎች ውስጥ የ\"በጅማሬ ላይ አሂድ\" መቀያየሪያ ተጨምሯል (ነባሪ፦ false)"

#: data/io.github.tobagin.karere.metainfo.xml.in:314
msgid ""
"Added GStreamer/PipeWire env vars to production Flatpak for efficient media "
"handling"
msgstr ""
"ለቀልጣፋ የመገናኛ ብዙኃን አያያዝ ወደ ምርት Flatpak የ GStreamer/PipeWire env vars ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:702
msgid "Added WebKit cache control setting for improved rendering consistency"
msgstr "ለተሻለ የማቅረቢያ ወጥነት የ WebKit መሸጎጫ መቆጣጠሪያ ቅንብር ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:376
msgid ""
"Added WebRTC permission handling in preparation for WhatsApp Web voice/video "
"calls"
msgstr "ለ WhatsApp Web ድምፅ/ቪዲዮ ጥሪዎች ዝግጅት የ WebRTC ፈቃድ አያያዝ ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:361
msgid ""
"Added Zoom support (Ctrl +/-/0) with persistence and preference controls"
msgstr "ከጽናት እና ከምርጫ መቆጣጠሪያዎች ጋር የማጉላት ድጋፍ (Ctrl +/-/0) ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:195
msgid ""
"Added an experimental \"GPU Rendering\" option (Preferences → General → "
"Experimental) that renders the chat view on the GPU via accelerated off-"
"screen rendering for lower CPU and power use. Off by default and requires a "
"restart; if the chat area is blank on your hardware, turn it off and restart"
msgstr ""

#: data/io.github.tobagin.karere.metainfo.xml.in:746
msgid "Added compile-time conditional compilation using DEVELOPMENT flag"
msgstr "DEVELOPMENT ባንዲራን በመጠቀም የ compile-time ሁኔታዊ ኮምፓይሊንግ ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:352
msgid "Added complete multi-account support with sidebar and tray integration"
msgstr "ከጎን አሞሌ እና ከመሳቢያ ውህደት ጋር ሙሉ ባለብዙ-መለያ ድጋፍ ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:748
msgid "Added contributors Aman Das and Cameo to about dialog"
msgstr "አስተዋጽዖ አበርካቾች Aman Das እና Cameo ወደ ስለ መገናኛ ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:698
msgid ""
"Added high-quality Noto Color Emoji fonts (v2.047, Unicode 16.0 support)"
msgstr ""
"ከፍተኛ ጥራት ያላቸው የ Noto Color Emoji ቅርጸ ቁምፊዎች ተጨምረዋል (v2.047፣ የ Unicode 16.0 "
"ድጋፍ)"

#: data/io.github.tobagin.karere.metainfo.xml.in:462
msgid "Added middle-click paste from primary selection (selected text)"
msgstr "ከመጀመሪያ ምርጫ (የተመረጠ ጽሑፍ) የመሃል-ጠቅታ መለጠፍ ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:471
msgid "Added new application icons"
msgstr "አዳዲስ የመተግበሪያ አዶዎች ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:353
msgid "Added per-account zoom settings and improved accessibility"
msgstr "ለእያንዳንዱ መለያ ማጉላት ቅንብሮች እና የተሻሻለ ተደራሽነት ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:540
msgid "Added striped symbolic icons for development version"
msgstr "ለልማት ስሪት ባለ ሰንበር ተምሳሌታዊ አዶዎች ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:734
msgid "Added subpixel font scaling and advanced rendering optimizations"
msgstr "የንዑስ ፒክሰል ቅርጸ ቁምፊ ማመጣጠን እና የላቀ የማቅረቢያ ማመቻቸቶች ተጨምረዋል"

#: data/io.github.tobagin.karere.metainfo.xml.in:278
msgid "Added voice and video call support via WebRTC-enabled WebKitGTK 2.50.5"
msgstr "በ WebRTC-የነቃ WebKitGTK 2.50.5 በኩል የድምፅ እና ቪዲዮ ጥሪ ድጋፍ ተጨምሯል"

#: data/io.github.tobagin.karere.metainfo.xml.in:252
msgid ""
"Added: account switcher uses a popover on desktop windows (bottom sheet "
"preserved on mobile)"
msgstr ""
"ተጨምሯል፦ የመለያ መቀየሪያ በዴስክቶፕ መስኮቶች ላይ ብቅ ባይ ይጠቀማል (በተንቀሳቃሽ ላይ የታች ሉህ ተጠብቋል)"

#: data/io.github.tobagin.karere.metainfo.xml.in:250
msgid "Added: pin favorite spell-check languages to the top of the dropdown"
msgstr "ተጨምሯል፦ ተወዳጅ የፊደል-ማረጋገጫ ቋንቋዎችን ወደ ተቆልቋይ ምናሌ አናት ሰካ"

#: data/io.github.tobagin.karere.metainfo.xml.in:251
msgid ""
"Added: spell-check dropdown shows natural language names (\"English (UK)\") "
"instead of locale codes"
msgstr ""
"ተጨምሯል፦ የፊደል-ማረጋገጫ ተቆልቋይ ምናሌ ከ locale ኮዶች ይልቅ ተፈጥሯዊ የቋንቋ ስሞችን (\"English (UK)"
"\") ያሳያል"

#: data/io.github.tobagin.karere.metainfo.xml.in:819
msgid "Advanced notification system with native desktop integration"
msgstr "ከቤተኛ የዴስክቶፕ ውህደት ጋር የላቀ የማሳወቂያ ሥርዓት"

#: data/ui/preferences.ui:119
msgid "Allow inspecting and debugging the WebView"
msgstr "WebView ን መመርመር እና ማረም ይፍቀዱ"

#: data/ui/preferences.ui:177
msgid "Animate the tray icon when a new message arrives"
msgstr "አዲስ መልዕክት ሲደርስ የመሳቢያ አዶውን አንቀሳቅስ"

#: data/ui/preferences.ui:68
msgid "Appearance"
msgstr "መልክ"

#: data/ui/keyboard-shortcuts.ui:142
msgid "Application"
msgstr "መተግበሪያ"

#: data/ui/preferences.ui:72
msgid "Application language. Requires restart."
msgstr "የመተግበሪያ ቋንቋ። እንደገና ማስጀመር ያስፈልጋል።"

#: data/io.github.tobagin.karere.metainfo.xml.in:57
msgid "Application preferences and settings dialog"
msgstr "የመተግበሪያ ምርጫዎች እና ቅንብሮች መገናኛ"

#: data/ui/preferences.ui:385
msgid "Applied to all webviews"
msgstr "ለሁሉም የድር እይታዎች ተተግብሯል"

#: data/ui/preferences.ui:56 data/ui/preferences.ui:103
msgid "Auto"
