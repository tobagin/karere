#: data/io.github.tobagin.karere.metainfo.xml.in:759
msgid "Enhanced stability and performance optimizations"
msgstr "Подобрени оптимизации на стабилността и производителността"

#: data/io.github.tobagin.karere.metainfo.xml.in:880
msgid "Enhanced stability during long sessions"
msgstr "Подобрена стабилност по време на дълги сесии"

#: data/io.github.tobagin.karere.metainfo.xml.in:846
msgid "Enhanced stability for extended usage"
msgstr "Подобрена стабилност при продължителна употреба"

#: data/io.github.tobagin.karere.metainfo.xml.in:695
msgid "Enhanced visual documentation for users"
msgstr "Подобрена визуална документация за потребителите"

#: data/io.github.tobagin.karere.metainfo.xml.in:640
msgid "Ensure application starts properly in the background without delay"
