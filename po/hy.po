#: data/io.github.tobagin.karere.metainfo.xml.in:53
msgid "About dialog showing application information"
msgstr "Մասին երկխոսությունը, որը ցույց է տալիս հավելվածի տեղեկությունները"

#: data/ui/preferences.ui:348
msgid "Accessibility"
msgstr "Մատչելիություն"

#: data/ui/preferences.ui:428
msgid "Accessibility Shortcuts"
msgstr "Մատչելիության դյուրանցումներ"

#: data/ui/preferences.ui:378
msgid "Accessibility Zoom"
msgstr "Մատչելիության մասշտաբավորում"

#: data/io.github.tobagin.karere.metainfo.xml.in:310
msgid ""
"Accessibility preferences: reduce-motion, focus-ring visibility, and caret "
"browsing"
msgstr ""
"Մատչելիության նախընտրություններ՝ նվազեցնել շարժումը, կենտրոնացման օղակի "
"տեսանելիություն և շարժագնա դիտում"

#: data/io.github.tobagin.karere.metainfo.xml.in:306
msgid ""
"Account identity (name + avatar) auto-discovered from WhatsApp Web's "
"internal Store, with a degraded DOM-scrape fallback surfaced by a badge"
msgstr ""
"Հաշվի ինքնությունը (անուն + ավատար) ինքնաշխատ հայտնաբերվում է WhatsApp Web-ի "
"ներքին Store-ից՝ վատթարացած DOM-քերծման պահեստային տարբերակով, որը "
"ցուցադրվում է կրծքանշանով"

#: data/ui/keyboard-shortcuts.ui:38
msgid "Accounts"
msgstr "Հաշիվներ"

#: data/ui/window.ui:237 data/ui/account_switcher.ui:48
msgid "Add new account"
msgstr "Ավելացնել նոր հաշիվ"

#: data/io.github.tobagin.karere.metainfo.xml.in:573
msgid "Add new contributor Sabri Ünal to the About dialog"
msgstr "Ավելացվեց նոր ներդրող Sabri Ünal-ը Մասին երկխոսությանը"

#: data/io.github.tobagin.karere.metainfo.xml.in:595
msgid "Add xdg-config/autostart permission for autostart support"
msgstr ""
"Ավելացվեց xdg-config/autostart թույլտվությունը ինքնագործարկման աջակցության "
"համար"

#: data/io.github.tobagin.karere.metainfo.xml.in:613
msgid "Added \"Run on Startup\" toggle in preferences (default: false)"
msgstr ""
"Ավելացվեց \"Գործարկել մուտքագործելիս\" անջատիչը նախընտրություններում "
"(լռելյայն՝ false)"

#: data/io.github.tobagin.karere.metainfo.xml.in:390
msgid ""
"Added GStreamer/PipeWire env vars to production Flatpak for efficient media "
"handling"
msgstr ""
"Ավելացվեցին GStreamer/PipeWire միջավայրի փոփոխականներ արտադրական Flatpak-ին՝ "
"արդյունավետ մեդիա մշակման համար"

#: data/io.github.tobagin.karere.metainfo.xml.in:778
msgid "Added WebKit cache control setting for improved rendering consistency"
msgstr ""
"Ավելացվեց WebKit քեշի կառավարման կարգավորում ցուցադրման բարելավված "
"հետևողականության համար"

#: data/io.github.tobagin.karere.metainfo.xml.in:452
msgid ""
"Added WebRTC permission handling in preparation for WhatsApp Web voice/video "
"calls"
msgstr ""
"Ավելացվեց WebRTC թույլտվության մշակումը WhatsApp Web ձայնային/տեսազանգերի "
"նախապատրաստման համար"

#: data/io.github.tobagin.karere.metainfo.xml.in:437
msgid ""
"Added Zoom support (Ctrl +/-/0) with persistence and preference controls"
msgstr ""
"Ավելացվեց մասշտաբավորման աջակցություն (Ctrl +/-/0)՝ պահպանմամբ և "
"նախընտրությունների կառավարներով"

#: data/io.github.tobagin.karere.metainfo.xml.in:271
msgid ""
"Added an experimental \"GPU Rendering\" option (Preferences → General → "
"Experimental) that renders the chat view on the GPU via accelerated off-"
"screen rendering for lower CPU and power use. Off by default and requires a "
"restart; if the chat area is blank on your hardware, turn it off and restart"
msgstr ""

#: data/io.github.tobagin.karere.metainfo.xml.in:822
msgid "Added compile-time conditional compilation using DEVELOPMENT flag"
msgstr ""
"Ավելացվեց կոմպիլյացիայի ժամանակ պայմանական կոմպիլյացիա՝ օգտագործելով "
"DEVELOPMENT դրոշը"

#: data/io.github.tobagin.karere.metainfo.xml.in:428
msgid "Added complete multi-account support with sidebar and tray integration"
msgstr ""
"Ավելացվեց բազմահաշվային լիարժեք աջակցություն կողագոտու և սկուտեղի ինտեգրմամբ"

#: data/io.github.tobagin.karere.metainfo.xml.in:824
msgid "Added contributors Aman Das and Cameo to about dialog"
msgstr "Ավելացվեցին ներդրողներ Aman Das-ը և Cameo-ն Մասին երկխոսությանը"

#: data/io.github.tobagin.karere.metainfo.xml.in:774
msgid ""
"Added high-quality Noto Color Emoji fonts (v2.047, Unicode 16.0 support)"
msgstr ""
"Ավելացվեցին բարձրորակ Noto Color Emoji տառատեսակներ (v2.047, Unicode 16.0 "
"աջակցություն)"

#: data/io.github.tobagin.karere.metainfo.xml.in:538
msgid "Added middle-click paste from primary selection (selected text)"
msgstr ""
"Ավելացվեց միջին սեղմումով կպցնելը առաջնային ընտրությունից (ընտրված տեքստ)"

#: data/io.github.tobagin.karere.metainfo.xml.in:547
msgid "Added new application icons"
msgstr "Ավելացվեցին հավելվածի նոր պատկերակներ"

#: data/io.github.tobagin.karere.metainfo.xml.in:429
msgid "Added per-account zoom settings and improved accessibility"
msgstr ""
"Ավելացվեցին ըստ հաշվի մասշտաբավորման կարգավորումներ և բարելավված "
"մատչելիություն"

#: data/io.github.tobagin.karere.metainfo.xml.in:616
msgid "Added striped symbolic icons for development version"
msgstr "Ավելացվեցին գծավոր խորհրդանշական պատկերակներ մշակման տարբերակի համար"

#: data/io.github.tobagin.karere.metainfo.xml.in:810
msgid "Added subpixel font scaling and advanced rendering optimizations"
msgstr ""
"Ավելացվեց ենթապիքսելային տառատեսակի մասշտաբավորում և ընդլայնված ցուցադրման "
"օպտիմիզացիաներ"

#: data/io.github.tobagin.karere.metainfo.xml.in:354
msgid "Added voice and video call support via WebRTC-enabled WebKitGTK 2.50.5"
msgstr ""
"Ավելացվեց ձայնային և տեսազանգերի աջակցություն WebRTC-ով միացված WebKitGTK "
"2.50.5-ի միջոցով"

#: data/io.github.tobagin.karere.metainfo.xml.in:328
msgid ""
"Added: account switcher uses a popover on desktop windows (bottom sheet "
"preserved on mobile)"
msgstr ""
"Ավելացվեց՝ հաշիվների փոխարկիչը օգտագործում է թռուցիկ աշխատասեղանի "
"պատուհաններում (ստորին թերթիկը պահպանված է բջջայինում)"

#: data/io.github.tobagin.karere.metainfo.xml.in:326
msgid "Added: pin favorite spell-check languages to the top of the dropdown"
msgstr ""
"Ավելացվեց՝ ամրացնել նախընտրած ուղղագրության ստուգման լեզուները բացվող ցանկի "
"վերևում"

#: data/io.github.tobagin.karere.metainfo.xml.in:327
msgid ""
"Added: spell-check dropdown shows natural language names (\"English (UK)\") "
"instead of locale codes"
msgstr ""
"Ավելացվեց՝ ուղղագրության ստուգման բացվող ցանկը ցույց է տալիս բնական լեզվի "
"անունները (\"English (UK)\")՝ տեղայնացման կոդերի փոխարեն"

#: data/io.github.tobagin.karere.metainfo.xml.in:895
msgid "Advanced notification system with native desktop integration"
msgstr "Առաջադեմ ծանուցումների համակարգ բնիկ աշխատասեղանի ինտեգրմամբ"

#: data/io.github.tobagin.karere.metainfo.xml.in:150
msgid "All dependencies updated to their latest releases."
msgstr ""

#: data/ui/preferences.ui:119
msgid "Allow inspecting and debugging the WebView"
msgstr "Թույլատրել WebView-ի ստուգումն ու վրիպազերծումը"

#: data/io.github.tobagin.karere.metainfo.xml.in:128
msgid ""
"Also includes the 4.3.1 fixes, which were never published: stalled scrolling "
"with software rendering (#173, #179), start-up failing on systems whose "
"hostname changes between boots (#190), and start-up failing on hardware "
"without OpenGL ES 3.0 (#177)."
msgstr ""

#: data/ui/preferences.ui:177
msgid "Animate the tray icon when a new message arrives"
msgstr "Աշխուժացնել սկուտեղի պատկերակը, երբ նոր հաղորդագրություն է գալիս"

